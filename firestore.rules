// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: Firebase Auth uid
// Fields:
//   - uid: string (required, immutable, must equal auth.uid)
//   - email: string (required, immutable after create, valid email)
//   - name: string (required, 1-80 chars)
//   - role: string ('student' | 'admin', optional for legacy docs)
//   - phone: string (optional, E.164)
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required)
//
// Collection: programs
// Document ID: auto
// Fields include: ownerId, adminIds[], studentIds[], inviteCode, ...
// Subcollections: students/{studentId}, sessions/{sessionId}
//   sessions/{sessionId}/attendance/{sessionId_studentId}
//
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAppAdmin() {
      return isAuthenticated()
        && exists(userPath())
        && 'role' in get(userPath()).data
        && get(userPath()).data.role == 'admin';
    }

    function isInstructor() {
      return isAuthenticated()
        && exists(userPath())
        && 'role' in get(userPath()).data
        && get(userPath()).data.role == 'instructor';
    }

    function isStaff() {
      return isAppAdmin() || isInstructor() || isGlobalAdmin();
    }

    function isValidRole(role) {
      return role is string && (role == 'student' || role == 'admin' || role == 'instructor');
    }

    // True when the caller has role:'admin' in their Firebase custom claims
    function isGlobalAdmin() {
      return isAuthenticated()
        && request.auth.token != null
        && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    function programPath(programId) {
      return /databases/$(database)/documents/programs/$(programId);
    }

    function programData(programId) {
      return get(programPath(programId)).data;
    }

    function isProgramAdmin(programId) {
      return isAuthenticated()
        && exists(programPath(programId))
        && (
          request.auth.uid == programData(programId).ownerId
          || (
            'adminIds' in programData(programId)
            && programData(programId).adminIds is list
            && request.auth.uid in programData(programId).adminIds
          )
          || isStaff()
        );
    }

    function isProgramStudent(programId) {
      return isAuthenticated()
        && (
          (
            exists(programPath(programId))
            && 'studentIds' in programData(programId)
            && programData(programId).studentIds is list
            && request.auth.uid in programData(programId).studentIds
          )
          || exists(/databases/$(database)/documents/programs/$(programId)/students/$(request.auth.uid))
        );
    }

    function isProgramMember(programId) {
      return isProgramAdmin(programId) || isProgramStudent(programId);
    }

    function isProgramAdminFromResource() {
      return isAuthenticated()
        && (
          request.auth.uid == resource.data.ownerId
          || (
            'adminIds' in resource.data
            && resource.data.adminIds is list
            && request.auth.uid in resource.data.adminIds
          )
          || isStaff()
        );
    }

    function isJoiningProgram() {
      return isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['studentIds', 'studentCount'])
        && !(request.auth.uid in resource.data.studentIds)
        && request.auth.uid in request.resource.data.studentIds
        && request.resource.data.studentCount == resource.data.studentCount + 1;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isGlobalAdmin();
      allow delete: if isOwner(userId) || isGlobalAdmin();
    }

    // Authenticated read keeps invite-code join working until a Cloud Function
    // owns enrollment. Writes stay restricted to admins / staff / self-enroll.
    match /programs/{programId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && (
          request.resource.data.ownerId == request.auth.uid
          || isStaff()
        );

      allow update: if isProgramAdminFromResource() || isStaff() || isJoiningProgram();

      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.ownerId || isStaff());

      match /students/{studentId} {
        allow read: if isStaff()
          || isProgramAdmin(programId)
          || request.auth.uid == studentId;
        allow create: if isAuthenticated()
          && (request.auth.uid == studentId || isProgramAdmin(programId) || isStaff());
        allow update, delete: if isStaff() || isProgramAdmin(programId);
      }

      match /sessions/{sessionId} {
        allow read: if isStaff() || isProgramMember(programId);
        allow create, delete: if isStaff() || isProgramAdmin(programId);
        allow update: if isStaff()
          || isProgramAdmin(programId)
          || (
            isAuthenticated()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceCount', 'updatedAt'])
          );

        match /attendance/{attendanceId} {
          allow read: if isStaff()
            || isProgramAdmin(programId)
            || (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));
          allow create: if isAuthenticated() && (
              (isStaff() || isProgramAdmin(programId))
              || (
                request.resource.data.studentId == request.auth.uid
                && request.resource.data.scannedBy == request.auth.uid
              )
            );
          allow update: if isStaff() || isProgramAdmin(programId);
          allow delete: if isStaff() || isProgramAdmin(programId);
        }
      }
    }

    // Required for collectionGroup('attendance') queries (student history & admin reports).
    // Nested path rules alone do not apply to collection group listens.
    match /{path=**}/attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        isStaff()
        || resource == null
        || resource.data.studentId == request.auth.uid
        || ('programId' in resource.data && isProgramAdmin(resource.data.programId))
      );
    }

    match /instructorInvites/{code} {
      // 1. Authenticated users can read invite codes (needed by students to validate & redeem)
      allow read: if isAuthenticated();

      // 2. Authenticated admins / staff can create new invite codes
      allow create: if isAuthenticated()
        && (
          isStaff()
          || isAppAdmin()
          || isGlobalAdmin()
          || request.resource.data.createdBy == request.auth.uid
        );

      // 3. Updating an invite: either by admin/staff or student redeeming an unused invite
      allow update: if isAuthenticated()
        && (
          isStaff()
          || isAppAdmin()
          || isGlobalAdmin()
          || (
            (!('used' in resource.data) || resource.data.used != true)
            && request.resource.data.used == true
            && request.resource.data.usedBy == request.auth.uid
          )
        );

      // 4. Admins / staff can delete invite codes
      allow delete: if isAuthenticated()
        && (isStaff() || isAppAdmin() || isGlobalAdmin());
    }
  }
}
