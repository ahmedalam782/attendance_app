# Sender Address
MAIL_FROM=noreply@attendanceapp.com

# OPTION 1: Resend API (Recommended for fastest setup)
# Sign up at resend.com, add domain attendanceapp.com, get API key
RESEND_API_KEY=re_your_api_key_here

# OPTION 2: SMTP Credentials (if using custom mail host / Google Workspace / Zoho / etc.)
# SMTP_HOST=smtp.attendanceapp.com
# SMTP_PORT=587
# SMTP_USER=noreply@attendanceapp.com
# SMTP_PASS=your_secret_password
